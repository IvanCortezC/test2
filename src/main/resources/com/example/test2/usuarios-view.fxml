<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="297.0" prefWidth="506.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.test2.controller.UsuariosController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
      <HBox prefHeight="93.0" prefWidth="280.0" spacing="10">
            <TextField fx:id="txtNombre" prefHeight="25.0" prefWidth="135.0" promptText="Nombre" />
            <TextField fx:id="txtProfesion" prefHeight="25.0" prefWidth="132.0" promptText="Profesión" />
            <Button onAction="#handleCrear" prefHeight="25.0" prefWidth="58.0" text="Crear" />
            <Button fx:id="btnEliminar" onAction="#handleEliminar" prefHeight="25.0" prefWidth="58.0" text="Eliminar" disable="true" />

      </HBox>
    <TextField fx:id="txtResultado" disable="true" prefWidth="200.0" promptText="Resultado" />
    <TableView fx:id="tableUsuarios" onMouseClicked="#handleSelectTable">
        <columns>
            <TableColumn fx:id="colId" text="ID"/>
            <TableColumn fx:id="colNombre" text="Nombre"/>
            <TableColumn fx:id="colProfesion" text="Profesión"/>
        </columns>
   </TableView>
</VBox>
